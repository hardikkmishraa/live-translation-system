# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,*"

# Audio & Processing Configuration
SAMPLE_RATE=16000
TEMP_STORAGE_DIR=temp_storage
MAX_UPLOAD_SIZE_MB=25
MAX_DURATION_SECONDS=180.0

# Model Configurations
# ASR: "openai/whisper-tiny", "openai/whisper-base", or "wav2vec2"
ASR_MODEL_ID=openai/whisper-tiny
ASR_DEVICE=auto

# SER (Speech Emotion Recognition): "wav2vec2" or "hybrid_acoustic"
SER_MODEL_ID=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
SER_DEVICE=auto

# NMT (Neural Machine Translation): Helsinki-NLP models for Hindi <-> English
NMT_HI_TO_EN_MODEL=Helsinki-NLP/opus-mt-hi-en
NMT_EN_TO_HI_MODEL=Helsinki-NLP/opus-mt-en-hi

# TTS (Text-to-Speech): "macos_native", "edge_tts", or "system"
TTS_ENGINE=macos_native
TTS_DEFAULT_VOICE_HI=Lekha
TTS_DEFAULT_VOICE_EN=Samantha

# Emotion Preservation
ENABLE_EMOTION_GATING=True
VOICE_PITCH_MODULATION=True
VOICE_RATE_MODULATION=True
